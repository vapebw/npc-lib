{
  "name": "vapebw/npc-lib",
  "description": "NPC library for Quark API 6.0.0",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "php-64bit": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "NpcLib\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NpcLibTests\\Unit\\": "tests/unit/",
      "NpcLibTests\\Integration\\": "tests/integration/"
    }
  },
  "extra": {
    "quark-api": "6.0.0",
    "quark-source": {
      "repository": "https://github.com/Bedrock-Phanatics/Quark",
      "ref": "0f91b13d470026cf6aefb5df649d32db9b0e342d"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.4.0"
    }
  },
  "scripts": {
    "lint": "@php scripts/lint.php",
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --no-progress",
    "check": [
      "@composer validate --strict",
      "@composer check-platform-reqs",
      "@lint",
      "@test",
      "@analyse"
    ],
    "build:harness": [
      "@php -d phar.readonly=0 scripts/build-plugin.php tests/harness NpcLibHarness",
      "@php -d phar.readonly=0 scripts/build-plugin.php tests/peer NpcLibPeer"
    ],
    "build:bench": "@php -d phar.readonly=0 scripts/build-plugin.php bench/plugin NpcLibBench",
    "test:phar": "@php scripts/check-phar.php",
    "analyse:harness": "@php vendor/phpstan/phpstan/phpstan analyse -c phpstan-harness.neon --no-progress",
    "stage:package": [
      "@composer archive --format=tar --dir=work/dist --file=npc-lib",
      "@php scripts/stage-package.php"
    ]
  },
  "archive": {
    "exclude": [
      "/work",
      "/vendor",
      "/tests",
      "/bench",
      "/scripts",
      "/composer.lock",
      "/phpstan*.neon",
      "/phpunit.xml",
      "/.editorconfig",
      "/.gitignore",
      "/.gitattributes",
      "/.phpunit.cache",
      "/.github",
      "/docs"
    ]
  }
}
