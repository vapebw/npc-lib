{
  "name": "vapebw/npc-lib-harness",
  "description": "Integration harness plugin for npc-lib",
  "type": "quark-plugin",
  "license": "proprietary",
  "repositories": [
    {
      "type": "path",
      "url": "../../work/package",
      "options": {
        "symlink": false,
        "versions": {
          "vapebw/npc-lib": "0.0.0-dev"
        }
      }
    }
  ],
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "vapebw/npc-lib": "0.0.0-dev"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  }
}
